# =========================================================
# मित्रा हिंदू समाज सेवा फाउंडेशन - Apache .htaccess
# =========================================================

RewriteEngine On

# ---------------------------------------------------------
# 1. www और non-www दोनों को मुख्य वेबसाइट पर रखें
#    कोई अलग www subdomain website नहीं है, इसलिए www को
#    non-www मुख्य domain पर redirect किया जाएगा.
# ---------------------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ---------------------------------------------------------
# 2. HTTP को HTTPS पर redirect करें
# ---------------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ---------------------------------------------------------
# 3. Directory listing बंद
# ---------------------------------------------------------
Options -Indexes

# ---------------------------------------------------------
# 4. Custom 404 Error Page
#    किसी भी invalid/non-existing URL पर 404.html खुलेगा.
# ---------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------
# 5. Existing files/folders को सामान्य रूप से खुलने दें.
# ---------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ---------------------------------------------------------
# 6. अगर URL किसी existing file/folder से match नहीं करता,
#    Apache custom 404 page दिखाएगा.
# ---------------------------------------------------------

# ---------------------------------------------------------
# 7. Security: hidden files को public access से रोकें
#    .well-known को छोड़कर.
# ---------------------------------------------------------
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]

# ---------------------------------------------------------
# 8. Common sensitive files को block करें
# ---------------------------------------------------------
<FilesMatch "(^\.|composer\.(json|lock)|package(-lock)?\.json|\.env|config\.php|phpunit\.xml)$">
    Require all denied
</FilesMatch>

# ---------------------------------------------------------
# 9. Browser caching for static assets
# ---------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

# ---------------------------------------------------------
# 10. Compression
# ---------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
